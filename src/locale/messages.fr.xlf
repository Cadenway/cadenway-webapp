<?xml version="1.0" encoding="UTF-8" ?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="ng2.template">
    <body>
      <trans-unit id="errors.not-found.route-title" datatype="html">
        <source>Page not found</source>
        <target>Page introuvable</target>
      </trans-unit>
      <trans-unit id="errors.not-found.code" datatype="html">
        <source> Error 404 </source>
        <target>Erreur 404</target>
      </trans-unit>
      <trans-unit id="errors.not-found.title" datatype="html">
        <source> Page not found </source>
        <target>Page introuvable</target>
      </trans-unit>
      <trans-unit id="errors.not-found.text" datatype="html">
        <source> The link is incomplete, or the page was moved or deleted. Check the address or search for what you wanted to open. </source>
        <target>Le lien est incomplet, ou la page a été déplacée ou supprimée. Vérifiez l’adresse ou cherchez ce que vous vouliez ouvrir.</target>
      </trans-unit>
      <trans-unit id="errors.back-home" datatype="html">
        <source>Back to home</source>
        <target>Retour à l’accueil</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.code" datatype="html">
        <source> Access denied </source>
        <target>Accès refusé</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.title" datatype="html">
        <source> You do not have access to this space </source>
        <target>Vous n’avez pas accès à cet espace</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.private-space" datatype="html">
        <source>“<x id="INTERPOLATION" equiv-text="{{ resource.name }}"/>” is a private space.</source>
        <target>« <x id="INTERPOLATION" equiv-text="{{ resource.name }}"/> » est un espace privé.</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.owner-can-add" datatype="html">
        <source><x id="INTERPOLATION" equiv-text="{{ resource.ownerName }}"/>, its owner, can add you.</source>
        <target><x id="INTERPOLATION" equiv-text="{{ resource.ownerName }}"/>, sa propriétaire, peut vous y ajouter.</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.message-label" datatype="html">
        <source>Message for <x id="INTERPOLATION" equiv-text="{{ owner }}"/> <x id="START_TAG_SPAN" ctype="x-span" equiv-text="&lt;span class=&quot;font-normal text-muted-foreground&quot;&gt;"/>(optional)<x id="CLOSE_TAG_SPAN" ctype="x-span" equiv-text="&lt;/span&gt;"/></source>
        <target>Message pour <x id="INTERPOLATION" equiv-text="{{ owner }}"/> <x id="START_TAG_SPAN" ctype="x-span" equiv-text="&lt;span class=&quot;font-normal text-muted-foreground&quot;&gt;"/>(facultatif)<x id="CLOSE_TAG_SPAN" ctype="x-span" equiv-text="&lt;/span&gt;"/></target>
      </trans-unit>
      <trans-unit id="errors.access-denied.message-label-anonymous" datatype="html">
        <source>Message <x id="START_TAG_SPAN" ctype="x-span" equiv-text="&lt;span class=&quot;font-normal text-muted-foreground&quot;&gt;"/>(optional)<x id="CLOSE_TAG_SPAN" ctype="x-span" equiv-text="&lt;/span&gt;"/></source>
        <target>Message <x id="START_TAG_SPAN" ctype="x-span" equiv-text="&lt;span class=&quot;font-normal text-muted-foreground&quot;&gt;"/>(facultatif)<x id="CLOSE_TAG_SPAN" ctype="x-span" equiv-text="&lt;/span&gt;"/></target>
      </trans-unit>
      <trans-unit id="errors.access-denied.sent" datatype="html">
        <source>Request sent</source>
        <target>Demande envoyée</target>
      </trans-unit>
      <trans-unit id="errors.access-denied.request" datatype="html">
        <source>Request access</source>
        <target>Demander l’accès</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.code" datatype="html">
        <source> Task deleted </source>
        <target>Tâche supprimée</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.title" datatype="html">
        <source> This task has been deleted </source>
        <target>Cette tâche a été supprimée</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.text" datatype="html">
        <source> <x id="INTERPOLATION" equiv-text="{{ task.key }}"/> “<x id="INTERPOLATION_1" equiv-text="{{ task.name }}"/>” has been deleted. It stays in the trash for 30 days before being erased. </source>
        <target><x id="INTERPOLATION" equiv-text="{{ task.key }}"/> « <x id="INTERPOLATION_1" equiv-text="{{ task.name }}"/> » a été supprimée. Elle reste 30 jours dans la corbeille avant d’être effacée.</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.already-restored" datatype="html">
        <source>Already restored</source>
        <target>Déjà restaurée</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.restore" datatype="html">
        <source>Restore the task</source>
        <target>Restaurer la tâche</target>
      </trans-unit>
      <trans-unit id="errors.deleted-task.open-trash" datatype="html">
        <source>Open the trash</source>
        <target>Ouvrir la corbeille</target>
      </trans-unit>
      <trans-unit id="errors.unavailable.title" datatype="html">
        <source>Could not load this page</source>
        <target>Impossible de charger cette page</target>
      </trans-unit>
      <trans-unit id="errors.unavailable.text" datatype="html">
        <source> The server did not answer in time. Your data is not lost: try again in a moment. </source>
        <target>Le serveur n’a pas répondu à temps. Vos données ne sont pas perdues : réessayez dans un instant.</target>
      </trans-unit>
      <trans-unit id="errors.unavailable.retry" datatype="html">
        <source>Retry</source>
        <target>Réessayer</target>
      </trans-unit>
      <trans-unit id="errors.unavailable.status" datatype="html">
        <source>Error <x id="INTERPOLATION" equiv-text="{{ code }}"/></source>
        <target>Erreur <x id="INTERPOLATION" equiv-text="{{ code }}"/></target>
      </trans-unit>
      <trans-unit id="errors.unavailable.reference" datatype="html">
        <source>ref. <x id="INTERPOLATION" equiv-text="{{ reference }}"/></source>
        <target>réf. <x id="INTERPOLATION" equiv-text="{{ reference }}"/></target>
      </trans-unit>
      <trans-unit id="home.route.title" datatype="html">
        <source>Home</source>
        <target>Accueil</target>
      </trans-unit>
      <trans-unit id="home.header.greeting" datatype="html">
        <source> Hello <x id="INTERPOLATION" equiv-text="{{ firstName() }}"/> </source>
        <target>Bonjour <x id="INTERPOLATION" equiv-text="{{ firstName() }}"/></target>
      </trans-unit>
      <trans-unit id="workspace.organization-switcher.label" datatype="html">
        <source>Switch organization: <x id="INTERPOLATION" equiv-text="{{ workspace().organization().name }}"/></source>
        <target>Changer d’organisation : <x id="INTERPOLATION" equiv-text="{{ workspace().organization().name }}"/></target>
      </trans-unit>
      <trans-unit id="layouts.app-shell.rail" datatype="html">
        <source>Applications</source>
        <target>Applications</target>
      </trans-unit>
      <trans-unit id="layouts.app-shell.sidebar" datatype="html">
        <source>Space navigation</source>
        <target>Navigation des espaces</target>
      </trans-unit>
      <trans-unit id="layouts.app-shell.sidebar-close" datatype="html">
        <source>Close the sidebar</source>
        <target>Fermer la barre latérale</target>
      </trans-unit>
      <trans-unit id="layouts.app-shell.sidebar-collapse" datatype="html">
        <source>Collapse the sidebar</source>
        <target>Replier la barre latérale</target>
      </trans-unit>
      <trans-unit id="layouts.app-shell.sidebar-expand" datatype="html">
        <source>Expand the sidebar</source>
        <target>Déplier la barre latérale</target>
      </trans-unit>
    </body>
  </file>
</xliff>

{
  "name": "cadenway-webapp",
  "version": "0.2.0",
  "description": "Cadenway web application: the Angular application of the mockup.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:lint": "node --test rules/documentation.test.mjs",
    "test:architecture": "node --test tests/architecture/project.test.mjs",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && ngc -p tsconfig.spec.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "quality": "pnpm format:check && pnpm test:lint && pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@angular/aria": "^22.2.6",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@cadenway/api-client": "^0.1.0",
    "@cadenway/contracts": "^0.1.0",
    "@cadenway/icons": "^0.3.0",
    "@cadenway/tokens": "^0.2.0",
    "@cadenway/ui": "^0.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@sentry/angular": "^11.12.0",
    "@simplewebauthn/browser": "^14.0.0",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "qr": "^0.7.2",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.4",
    "temporal-polyfill": "^1.0.8",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@cadenway/angular-testing": "0.1.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@ngrx/eslint-plugin": "^22.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
